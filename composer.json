{
    "name": "ooriyap/filament-simple-otp",
    "description": "FilamentPHP Simple OTP & Password Authentication Plugin with Dynamic Model Support",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "authentication",
        "otp",
        "sms-otp"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ooriyaP",
            "email": "info@advento.ir"
        }
    ],
    "require": {
        "php": "^8.2",
        "cryptommer/smsir": "^1.2",
        "filament/filament": "^3.0|^4.0|^5.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "OoriyaP\\FilamentSimpleOtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OoriyaP\\FilamentSimpleOtp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OoriyaP\\FilamentSimpleOtp\\SimpleOtpServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
